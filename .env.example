# SiteSage Environment Configuration
# Copy this file to .env and adjust values as needed.

# Server settings
HOST=127.0.0.1
PORT=8000

# SQLite database location (defaults to ./sitesage.db)
SITESAGE_DB_PATH=sitesage.db

# Optional AI Answer Polisher (Core search engine operates 100% deterministically without AI)
AI_POLISH_ENABLED=false
AI_POLISH_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=your_gemini_api_key_here
